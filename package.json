{
  "name": "indreelforge",
  "version": "1.1.0",
  "description": "Official Node.js SDK and MCP bridge for IndReelForge — one API to publish videos, photos, text & documents to Instagram, YouTube, TikTok, Facebook, X, LinkedIn, Threads, Pinterest, Reddit, Bluesky, Google Business Profile, Discord, Telegram, Slack, Mastodon & WordPress.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "indreelforge": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "npm run typecheck && npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit --strict --skipLibCheck --moduleResolution bundler --module esnext --target es2020 test/types/credentials.ts"
  },
  "keywords": [
    "social-media-api",
    "instagram-api",
    "youtube-api",
    "tiktok-api",
    "facebook-api",
    "twitter-api",
    "linkedin-api",
    "threads-api",
    "pinterest-api",
    "reddit-api",
    "bluesky-api",
    "social-media-posting",
    "video-upload",
    "multi-platform",
    "content-distribution",
    "social-media-automation",
    "social-media-scheduling",
    "indreelforge",
    "upload-api",
    "google-business",
    "google-business-profile-api",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "claude",
    "chatgpt",
    "cursor",
    "discord-api",
    "telegram-api",
    "slack-api",
    "mastodon-api",
    "wordpress-api"
  ],
  "author": "IndReelForge <support@indreelforge.com>",
  "license": "MIT",
  "homepage": "https://indreelforge.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Indreelforge/indreelforge-node"
  },
  "bugs": {
    "url": "https://github.com/Indreelforge/indreelforge-node/issues"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
